# Copy this file to ".env" and fill in the real values.
# DO NOT commit the ".env" file to git.

# Gemini API key from Google AI Studio (free, no credit card required)
GEMINI_API_KEY=

# API key from serpapi.com (dashboard > API Key)
SERPAPI_KEY=

# Telegram bot token (can reuse an existing orchestrator bot, or create a
# new one via @BotFather)
TG_BOT_TOKEN=

# Target chat ID for notifications. How to find it: send any message to
# the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates and
# look for the "chat":{"id": ...} field.
TG_CHAT_ID=

# Folder to store promo history (optional, defaults to "./harness-data"
# relative to the working directory the program is run from).
# Example on Windows during testing: OUTPUT_DIR=D:/Projects/harness/harness-data
# Example on the Armbian STB:        OUTPUT_DIR=/mnt/external/harness-data
OUTPUT_DIR=

# Region used for the automatic weekly search (cron). Optional, default "Jabodetabek".
REGION=Jabodetabek

# Enables the "how much is this being talked about" signal (checks
# Instagram, TikTok, Facebook, YouTube, X, Threads via SerpApi). Adds 1
# EXTRA SerpApi call per promo (up to ~40/week). Set "false" to save quota.
ENABLE_BUZZ_CHECK=true

# Enables filtering out promos whose source link is unreachable (dead
# links, 404, etc). Set "false" to disable if it causes too many false
# negatives on your network.
ENABLE_LINK_VALIDATION=true
